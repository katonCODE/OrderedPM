# Database connection string from Supabase
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Supabase JWT Secret (found in Supabase project settings > API > JWT Secret)
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Server port (defaults to 5000 if not set)
PORT=5000

# Upstash Redis (for rate limiting)
# Get these from https://console.upstash.com after creating a Redis database
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token-here

# AI Rate Limit Configuration (optional, defaults to 5 requests per 5 minutes)
AI_RATE_LIMIT_MAX=5
