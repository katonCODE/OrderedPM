# Database connection string from Supabase
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Supabase JWT Secret (found in Supabase project settings > API > JWT Secret)
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Server port (defaults to 5000 if not set)
PORT=5000

# AI Rate Limit Configuration (optional, defaults to 5 requests per 5 minutes)
# Rate limiting now uses PostgreSQL (Supabase) - no additional configuration needed
AI_RATE_LIMIT_MAX=5

# Gemini API Key (for AI task generation)
# Get from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
